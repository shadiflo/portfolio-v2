---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const categoryNames: Record<string, string> = {
  web: "Web app",
  esports: "Esports",
  bots: "Automation",
  community: "Community",
};
const categoryLabel = categoryNames[project.category] ?? project.category;
const symbol = project.category === "web" ? "◈" : project.category === "bots" ? "⌘" : project.category === "community" ? "✳" : "⌁";
---

<article class="work-folder" id={"project-" + project.id}>
  <div class="work-folder__tab" aria-hidden="true"></div>
  <div class="work-card">
    <div class="project-art" data-category={project.category}>
      {project.image ? (
        <img class="project-art__image" src={project.image} alt={project.title + " project artwork"} loading="lazy" />
      ) : (
        <div class="project-art__generated" aria-hidden="true">
          <span class="project-art__eyebrow">PROJECT / {categoryLabel}</span>
          <span class="project-art__symbol">{symbol}</span>
          <span class="project-art__name">{project.title}</span>
          <span class="project-art__line"></span>
        </div>
      )}
      <span class="project-art__category">{categoryLabel}</span>
    </div>

    <div class="work-card__content">
      <p class="work-card__eyebrow">{categoryLabel}<span aria-hidden="true"> · </span>{project.stack[0] ?? "Independent project"}</p>
      <h3 class="work-card__title">{project.title}</h3>
      <p class="work-card__description">{project.description}</p>

      {project.stack.length > 0 && (
        <ul class="work-card__tags" aria-label="Technologies">
          {project.stack.map((tech) => <li>{tech}</li>)}
        </ul>
      )}

      {project.url ? (
        <a class="work-card__link" href={project.url} target="_blank" rel="noopener noreferrer">
          Open project
          <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
            <path d="M4 12 12 4M5 4h7v7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ) : (
        <span class="work-card__archive-label">Project archive</span>
      )}
    </div>
  </div>
</article>
