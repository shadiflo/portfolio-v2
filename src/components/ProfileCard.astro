---
import { profile } from "../data/profile";
---

<aside class="profile-card">
  <img src={profile.avatar} alt={profile.name} class="profile-card__avatar" loading="lazy" />
  <h2 class="profile-card__name">{profile.name}</h2>
  <p class="profile-card__role">{profile.role}</p>
  <p class="profile-card__location">{profile.location}</p>
  <p class="profile-card__bio">{profile.headline}</p>
  <a class="profile-card__link" href="/#about">More about me <span aria-hidden="true">↗</span></a>
</aside>
