---
import type { Project } from "../data/projects";

const { project } = Astro.props;
const href = project.url ?? ("/projects/#project-" + project.id);
const external = Boolean(project.url);
---

<a
  href={href}
  class="compact-project"
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span class="compact-project__title">{project.title}</span>
  <span class="compact-project__description">{project.description}</span>
  <span class="compact-project__tags">
    {project.stack.slice(0, 3).map((tech) => <span>{tech}</span>)}
  </span>
</a>
