---
const currentPath = Astro.url.pathname;
const navLinks = [
  { label: "About", href: "/#about" },
  { label: "Skills", href: "/#skills" },
  { label: "Experience", href: "/#experience" },
  { label: "Projects", href: "/projects/" },
  { label: "Blog", href: "/blog/" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-brand" aria-label="shadi.dev home">
      <span aria-hidden="true" class="site-brand__icon">📘</span>
      <span>shadi<span class="site-brand__dot">.dev</span></span>
    </a>

    <div class="site-header__actions">
      <nav class="site-nav" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "site-nav__link",
              (link.href === "/blog/" && currentPath.startsWith("/blog")) ||
              (link.href === "/projects/" && currentPath === "/projects/")
                ? "is-active"
                : "",
            ]}
          >
            {link.label}
          </a>
        ))}
        <a class="site-nav__github" href="https://github.com/shadiflo" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-1.9c-3.1.67-3.75-1.32-3.75-1.32-.5-1.29-1.23-1.64-1.23-1.64-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.21 3.23.92.1-.71.39-1.21.71-1.49-2.47-.28-5.07-1.24-5.07-5.51 0-1.22.44-2.22.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.1-1.45 3.04-1.15 3.04-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.28-2.6 5.23-5.08 5.5.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
          </svg>
        </a>
      </nav>

      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to light theme" aria-pressed="false" title="Switch theme">
        <svg class="theme-icon theme-icon--sun" aria-hidden="true" viewBox="0 0 20 20" fill="none">
          <circle cx="10" cy="10" r="3.2" stroke="currentColor" stroke-width="1.4" />
          <path d="M10 1.8v2M10 16.2v2M18.2 10h-2M3.8 10h-2m14-5.8-1.4 1.4M5.6 14.4l-1.4 1.4m11.6 0-1.4-1.4M5.6 5.6 4.2 4.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <svg class="theme-icon theme-icon--moon" aria-hidden="true" viewBox="0 0 20 20" fill="none">
          <path d="M16.8 12.4A7.3 7.3 0 0 1 7.6 3.2a7.4 7.4 0 1 0 9.2 9.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const themeButton = document.getElementById("theme-toggle");
  if (themeButton) {
    const updateThemeButton = () => {
      const isLight = document.documentElement.classList.contains("light");
      themeButton.setAttribute("aria-label", isLight ? "Switch to dark theme" : "Switch to light theme");
      themeButton.setAttribute("aria-pressed", String(isLight));
    };

    updateThemeButton();
    themeButton.addEventListener("click", () => {
      const isLight = document.documentElement.classList.toggle("light");
      try {
        localStorage.setItem("shadidev-theme", isLight ? "light" : "dark");
      } catch {}
      updateThemeButton();
    });
  }
</script>
