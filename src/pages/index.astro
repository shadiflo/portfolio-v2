---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectWorkCard from "../components/ProjectWorkCard.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";

const featuredProjects = projects.filter((project) => project.featured);
const otherProjects = projects.filter((project) => !project.featured);
---

<BaseLayout>
  <Header />

  <main class="site-main" id="home">
    <section class="profile-hero" aria-labelledby="profile-name">
      <img class="profile-hero__avatar" src={profile.avatar} alt={profile.name} fetchpriority="high" />
      <p class="profile-hero__role">{profile.role}</p>
      <h1 id="profile-name" class="profile-hero__name">{profile.name}</h1>
      <p class="profile-hero__headline">{profile.headline}</p>

      <dl id="profile-details" class="profile-details">
        <div class="profile-details__row">
          <dt><span aria-hidden="true">📍</span>Location</dt>
          <dd>{profile.location}</dd>
        </div>
        <div class="profile-details__row">
          <dt><span aria-hidden="true">💻</span>Status</dt>
          <dd>{profile.role}</dd>
        </div>
        <div class="profile-details__row">
          <dt><span aria-hidden="true">💼</span>Open to</dt>
          <dd>
            <span class="availability-pill">
              <span class="availability-pill__dot" aria-hidden="true"></span>
              {profile.openTo}
            </span>
          </dd>
        </div>
        <div class="profile-details__row">
          <dt><span aria-hidden="true">✉️</span>Email</dt>
          <dd class="profile-details__email">
            <a href={"mailto:" + profile.email}>{profile.email}</a>
            <button class="copy-email" type="button" data-copy-email={profile.email} aria-label="Copy email address" title="Copy email address">⧉</button>
            <span class="copy-email__status" id="email-copy-status" aria-live="polite"></span>
          </dd>
        </div>
        <div class="profile-details__row">
          <dt><span aria-hidden="true">🐙</span>GitHub</dt>
          <dd>
            <a class="profile-details__link" href={profile.github} target="_blank" rel="noopener noreferrer">
              @shadiflo <span aria-hidden="true">↗</span>
            </a>
          </dd>
        </div>
      </dl>
    </section>

    <hr class="section-divider" />

    <section id="about" class="content-section scroll-mt-8" aria-labelledby="about-heading">
      <div class="section-heading">
        <span aria-hidden="true" class="section-heading__emoji">🧠</span>
        <h2 id="about-heading">About</h2>
      </div>
      <div class="about-copy">
        {profile.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <hr class="section-divider" />

    <section id="skills" class="content-section scroll-mt-8" aria-labelledby="skills-heading">
      <div class="section-heading">
        <span aria-hidden="true" class="section-heading__emoji">🛠️</span>
        <h2 id="skills-heading">Skills</h2>
      </div>
      <div class="skills-grid">
        {profile.skills.map((group) => (
          <div class="skill-group">
            <h3>{group.category}</h3>
            <ul class="skill-tags">
              {group.items.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <hr class="section-divider" />

    <section id="experience" class="content-section scroll-mt-8" aria-labelledby="experience-heading">
      <div class="section-heading">
        <span aria-hidden="true" class="section-heading__emoji">💼</span>
        <h2 id="experience-heading">Experience</h2>
      </div>
      <article class="experience-entry">
        <div class="experience-entry__top">
          <h3>{profile.experience.title}</h3>
          <span>{profile.experience.label}</span>
        </div>
        <p>{profile.experience.description}</p>
        <a href="#projects">See selected projects <span aria-hidden="true">↓</span></a>
      </article>
    </section>

    <hr class="section-divider" />

    <section id="projects" class="content-section scroll-mt-8" aria-labelledby="projects-heading">
      <div class="section-heading">
        <span aria-hidden="true" class="section-heading__emoji">🗂️</span>
        <h2 id="projects-heading">Selected projects</h2>
        <a class="section-heading__more" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
      </div>

      <div class="work-grid">
        {featuredProjects.map((project) => <ProjectWorkCard project={project} />)}
      </div>

      {otherProjects.length > 0 && (
        <div class="project-archive">
          <h3 class="project-archive__heading">Also in the cabinet</h3>
          <ul class="project-archive__list">
            {otherProjects.map((project) => (
              <li class="project-archive__row" id={"project-" + project.id}>
                <div class="project-archive__copy">
                  <h4>{project.title}</h4>
                  <p>{project.description}</p>
                  {project.stack.length > 0 && (
                    <div class="project-archive__tags">
                      {project.stack.map((tech) => <span>{tech}</span>)}
                    </div>
                  )}
                </div>
                {project.url && (
                  <a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={"Open " + project.title}>
                    <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
                      <path d="M4 12 12 4M5 4h7v7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <hr class="section-divider" />

    <section id="contact" class="content-section scroll-mt-8" aria-labelledby="contact-heading">
      <div class="section-heading">
        <span aria-hidden="true" class="section-heading__emoji">💌</span>
        <h2 id="contact-heading">Get in touch</h2>
      </div>
      <div class="contact-panel">
        <div>
          <p class="contact-panel__lead">Open to collaborations.</p>
          <p class="contact-panel__copy">Have an idea or want to work together? Send me a note or find me on GitHub.</p>
        </div>
        <div class="contact-panel__links">
          <a class="contact-panel__primary" href={"mailto:" + profile.email}>✉️ Email me</a>
          <a class="contact-panel__secondary" href={profile.github} target="_blank" rel="noopener noreferrer">🐙 GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="signature-block">
        <span class="signature" aria-label={"Signature: " + profile.name}>{profile.signature}</span>
        <span class="signature-block__name">{profile.name}</span>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  const copyEmailButton = document.querySelector("[data-copy-email]");
  const copyEmailStatus = document.getElementById("email-copy-status");

  copyEmailButton?.addEventListener("click", async () => {
    const email = copyEmailButton.getAttribute("data-copy-email");
    if (!email || !copyEmailStatus) return;

    try {
      await navigator.clipboard.writeText(email);
      copyEmailButton.textContent = "✓";
      copyEmailStatus.textContent = "Copied";
      window.setTimeout(() => {
        copyEmailButton.textContent = "⧉";
        copyEmailStatus.textContent = "";
      }, 1800);
    } catch {
      copyEmailStatus.textContent = "Select the email link to copy it.";
    }
  });
</script>
