---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectFolders from "../components/ProjectFolders";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects — Florin Stefanescu" description="Selected projects by Florin Stefanescu, including esports tools, browser apps, automation, and community work.">
  <Header />

  <main class="site-main projects-page" id="home">
    <p class="eyebrow">A few things I've built</p>
    <h1 class="page-title">Projects</h1>
    <p class="page-intro">Tools and products for competitive gaming, esports, and the web.</p>

    <ProjectFolders projects={projects} client:visible />
  </main>

  <Footer />
</BaseLayout>
